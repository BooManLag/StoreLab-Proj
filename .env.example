# --- Gemini via Vertex AI (recommended on Cloud Run; uses the service account, no key) ---
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global

# --- OR Gemini Developer API (local development) ---
# GEMINI_API_KEY=your-key

# --- Agent tuning (optional) ---
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_THINKING_LEVEL=low        # minimal | low | medium | high | default
# GEMINI_TIMEOUT_S=90
# STORELAB_AGENT_MODE=offline      # force the offline heuristic planner

# --- App (optional) ---
# STORELAB_LAB_RUNS_PER_MINUTE=6   # per instance, protects your Gemini quota
# STORELAB_SEED=20261018
# STORELAB_DATA_DIR=./data
# LOG_LEVEL=INFO
